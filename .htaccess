# test
RewriteEngine On

# wwwなし・httpsに統一
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://acus-fukuyama.com/$1 [R=301,L]
RewriteCond %{HTTP_HOST} ^www\.acus-fukuyama\.com [NC]
RewriteRule ^(.*)$ https://acus-fukuyama.com/$1 [R=301,L]

RewriteRule ^index\.html$ /index.php [R=301,L]
RewriteRule ^menu\.html$ /menu.php [R=301,L]
RewriteRule ^staff\.html$ /staff.php [R=301,L]
RewriteRule ^access\.html$ /access.php [R=301,L]
RewriteRule ^faq\.html$ /faq.php [R=301,L]
RewriteRule ^sitemap\.xml$ /sitemap.php [R=301,L]

# /column は index.html ではなく index.php を読み込む
RewriteRule ^column/?$ /column/index.html [L]

# config.php への直接HTTPアクセスを禁止（APIキー保護）
<Files "config.php">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</Files>